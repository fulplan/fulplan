# Test database — a SEPARATE database from dev, because the test suite
# truncates every table between runs. Local dev credentials only, no secrets.
# In CI these are already set as real env vars, which take precedence.
DATABASE_URL="postgresql://ghpos:ghpos_dev_password@localhost:5433/ghpos_test?schema=public"
NODE_ENV="test"
JWT_SECRET="test-only-secret-not-used-anywhere-real"
CORS_ORIGIN="http://localhost:5173"
