// GhPOS — multi-tenant retail POS
//
// Conventions (see Data-Model.md / Architecture.md in the project vault):
//  * Every tenant-scoped table carries organizationId and is indexed on it.
//    Isolation is enforced twice: app-level tRPC middleware AND Postgres RLS.
//  * All money is stored as Int in MINOR UNITS (pesewas). Never Float/Decimal.
//  * Stock will be event-sourced: stock_movements is the source of truth,
//    stock_levels a rebuildable cache. (Added with the inventory feature.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  LOCKED
  CANCELLED
}

/// A tenant. One shop business = one Organization.
model Organization {
  id   String @id @default(cuid())
  name String

  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?

  // Growth loop: every org gets a code; referredByCode records who sent them.
  referralCode   String  @unique
  referredByCode String?

  // Set when the org self-service deletes; retained through a grace period.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches       Branch[]
  users          User[]
  devices        Device[]
  categories     Category[]
  products       Product[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  sales          Sale[]
  shifts         Shift[]
  cashEntries    CashEntry[]
  customers        Customer[]
  creditEntries    CreditEntry[]
  suppliers        Supplier[]
  supplierEntries  SupplierEntry[]
  stockTakes       StockTake[]
  salaryRecords    SalaryRecord[]
  salaryPayments   SalaryPayment[]
  expenses         Expense[]

  @@index([subscriptionStatus])
  @@map("organizations")
}

/// A physical shop location. An Organization may have many.
model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  address String?

  // Printed at the top of receipts for this branch.
  receiptHeader String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  devices        Device[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  sales          Sale[]
  shifts         Shift[]
  stockTakes     StockTake[]
  expenses       Expense[]

  @@index([organizationId])
  @@map("branches")
}

/// Staff. Owners/managers sign in with email + password; cashiers with a PIN.
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  role  Role   @default(CASHIER)

  // Owner/manager identity + account recovery anchor.
  email        String?
  passwordHash String?

  // Cashier fast login. Device-bound and rate-limited at the API layer.
  pinHash String?

  phone String?

  // Cashiers are assigned to a branch; owners see all branches by default.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices        Device[]
  stockMovements StockMovement[]
  sales          Sale[]          @relation("SaleCashier")
  voidedSales    Sale[]          @relation("SaleVoidedBy")
  shifts         Shift[]         @relation("ShiftCashier")
  cashEntries    CashEntry[]
  creditEntries        CreditEntry[]
  supplierEntries      SupplierEntry[]
  createdStockTakes    StockTake[] @relation("StockTakeCreated")
  closedStockTakes     StockTake[] @relation("StockTakeClosed")
  salaryRecords        SalaryRecord[] @relation("SalaryEmployee")
  createdSalaryRecords SalaryRecord[] @relation("SalaryRecordCreated")
  salaryPayments       SalaryPayment[] @relation("SalaryPaymentEmployee")
  createdSalaryPayments SalaryPayment[] @relation("SalaryPaymentCreated")
  expenses             Expense[]

  // Email is unique per tenant, not globally — the same person could own
  // two separate shop businesses on the platform.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@map("users")
}

/// Product category — organises the product grid and reports.
model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("categories")
}

enum MovementType {
  PURCHASE   // stock in — receiving from supplier
  SALE       // stock out — from checkout
  ADJUSTMENT // manual correction / stock take
  RETURN     // stock back in — customer return
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  MOMO
  CREDIT // book sale on customer's tab
  SPLIT  // part cash + part MoMo — amounts in Sale.cashAmount / Sale.momoAmount
}

enum CreditEntryType {
  CHARGE  // credit sale added to balance
  PAYMENT // repayment reducing balance
}

enum SupplierEntryType {
  PURCHASE // stock bought on credit — we owe them
  PAYMENT  // money paid to supplier — reduces balance
}

enum StockTakeStatus {
  OPEN   // count in progress
  CLOSED // finalized; adjustments applied
}

enum SalaryPaymentType {
  PAYMENT // full or partial month salary paid
  ADVANCE // advance against future salary
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashEntryType {
  IN  // cash added to till (e.g. change float top-up)
  OUT // cash removed from till (e.g. owner takes expenses)
}

/// A sellable item.
///
/// Barcodes are TENANT-scoped — two shops legitimately use the same
/// manufacturer barcode for different local stock, so no global uniqueness.
///
/// Unit conversion: a "carton of 24 pieces" means purchaseUnit="carton",
/// saleUnit="piece", unitsPerPurchase=24.  Stock is always tracked in sale
/// units.
model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  barcode String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Unit conversion (purchase → sale).  Defaults to 1:1.
  purchaseUnit     String @default("unit")
  saleUnit         String @default("unit")
  unitsPerPurchase Int    @default(1)

  // All prices in PESEWAS (minor units).  Never Float.
  costPrice    Int // what we paid per sale unit
  sellingPrice Int // what we charge per sale unit

  lowStockThreshold Int @default(5)
  imageUrl          String?
  active            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  stockTakeItems StockTakeItem[]

  @@index([organizationId])
  @@index([organizationId, barcode])
  @@map("products")
}

/// Per-branch stock count cache.  Rebuilt from stock_movements if corrupted.
model StockLevel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  quantity Int @default(0) // in sale units

  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
  @@index([organizationId])
  @@map("stock_levels")
}

/// Append-only stock ledger.  Never update or delete rows — add corrections.
/// quantity is SIGNED: positive = stock in, negative = stock out (sale units).
model StockMovement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  type     MovementType
  quantity Int // signed, in sale units
  note     String?

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([productId, branchId])
  @@map("stock_movements")
}

/// A registered till/tablet/PC. Owners can revoke one remotely when a
/// device is lost or stolen, which invalidates its sessions.
model Device {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  label     String
  tokenHash String  @unique

  lastSeenAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("devices")
}

/// A completed or voided sales transaction.
model Sale {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId  String
  branch    Branch @relation(fields: [branchId], references: [id])
  cashierId String
  cashier   User   @relation("SaleCashier", fields: [cashierId], references: [id])

  status        SaleStatus    @default(COMPLETED)
  paymentMethod PaymentMethod

  // For credit sales — links to the customer's account.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // All amounts in PESEWAS.
  subtotal       Int
  discountTotal  Int @default(0)
  total          Int
  amountTendered Int
  change         Int @default(0)
  // For SPLIT sales — cash and MoMo portions. Both are 0 for single-method sales.
  cashAmount     Int @default(0)
  momoAmount     Int @default(0)

  note String?

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?    @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  voidReason String?

  createdAt DateTime @default(now())

  items          SaleItem[]
  stockMovements StockMovement[]
  creditEntries  CreditEntry[]

  @@index([organizationId])
  @@index([organizationId, branchId, createdAt])
  @@map("sales")
}

/// A single line item in a sale. Prices are snapshots at time of sale.
model SaleItem {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  name      String // snapshot — product name may change later
  quantity  Int
  unitPrice Int    // pesewas snapshot
  costPrice Int    // pesewas snapshot (for margin reporting)
  lineTotal Int    // pesewas = quantity * unitPrice

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

/// A cashier's till shift. One open shift per branch at a time.
/// The discrepancy between expected and counted cash is the till-theft signal.
model Shift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId  String
  branch    Branch @relation(fields: [branchId], references: [id])
  cashierId String
  cashier   User   @relation("ShiftCashier", fields: [cashierId], references: [id])

  status       ShiftStatus @default(OPEN)
  openingFloat Int         // pesewas — cash in till at start of shift

  // Computed and stored at close time so they don't change as history accumulates.
  countedCash  Int?        // pesewas — cashier's physical count
  expectedCash Int?        // pesewas = float + cash sales + cash entries net
  discrepancy  Int?        // pesewas = counted - expected (negative = shortage)

  openedAt DateTime  @default(now())
  closedAt DateTime?
  note     String?

  cashEntries CashEntry[]

  @@index([organizationId])
  @@index([branchId, status])
  @@index([organizationId, branchId, openedAt])
  @@map("shifts")
}

/// A customer of the shop. Optional profile — any customer, not just credit customers.
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  notes String?

  // null = no credit limit (unlimited). In pesewas.
  creditLimit Int?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales         Sale[]
  creditEntries CreditEntry[]

  @@index([organizationId])
  @@index([organizationId, phone])
  @@map("customers")
}

/// Append-only credit ledger. CHARGE = sale booked on credit; PAYMENT = money received.
/// Balance owed = sum(CHARGE amounts) − sum(PAYMENT amounts).
model CreditEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  type   CreditEntryType
  amount Int             // pesewas, always positive — type determines direction

  // Present when this entry was created by a credit sale.
  saleId String?
  sale   Sale?  @relation(fields: [saleId], references: [id], onDelete: SetNull)

  note        String?
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([organizationId])
  @@index([customerId])
  @@map("credit_entries")
}

/// Manual cash in/out entries recorded during a shift (not from sales).
/// Examples: owner removes GHS 50 for expenses; petty cash added to float.
model CashEntry {
  id             String       @id @default(cuid())
  shiftId        String
  shift          Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type   CashEntryType
  amount Int           // pesewas, always positive — type determines direction
  note   String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([shiftId])
  @@index([organizationId])
  @@map("cash_entries")
}

/// A supplier the shop buys stock from.
model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  phone String?
  email String?
  notes String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries SupplierEntry[]

  @@index([organizationId])
  @@map("suppliers")
}

/// Append-only accounts-payable ledger.
/// PURCHASE = we received goods on credit (we owe them more).
/// PAYMENT  = we paid them (reduces balance).
/// Balance owed = sum(PURCHASE amounts) − sum(PAYMENT amounts).
model SupplierEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  type   SupplierEntryType
  amount Int               // pesewas, always positive

  note        String?
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([organizationId])
  @@index([supplierId])
  @@map("supplier_entries")
}

/// A periodic stock count session for a branch.
/// On close: ADJUSTMENT movements are appended for every discrepancy,
/// and stock_levels cache is updated atomically.
model StockTake {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  status StockTakeStatus @default(OPEN)
  note   String?

  createdById String
  createdBy   User   @relation("StockTakeCreated", fields: [createdById], references: [id])

  closedById String?
  closedBy   User?  @relation("StockTakeClosed", fields: [closedById], references: [id])
  closedAt   DateTime?

  createdAt DateTime @default(now())

  items StockTakeItem[]

  @@index([organizationId])
  @@index([organizationId, branchId, status])
  @@map("stock_takes")
}

/// One line per product in a stock take session.
/// expectedQty is a snapshot from stock_levels at session open time.
/// countedQty is null until the user enters a count.
model StockTakeItem {
  id          String    @id @default(cuid())
  stockTakeId String
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  name        String // product name snapshot
  expectedQty Int    // stock level at session start
  countedQty  Int?   // null = not yet counted

  @@unique([stockTakeId, productId])
  @@index([stockTakeId])
  @@map("stock_take_items")
}

/// The agreed monthly salary for a staff member at a point in time.
/// Multiple records capture salary changes; the most recent is current.
model SalaryRecord {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("SalaryEmployee", fields: [userId], references: [id])

  agreedAmount  Int      // pesewas per month
  effectiveFrom DateTime @default(now())
  note          String?

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("SalaryRecordCreated", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@map("salary_records")
}

/// A salary payment or advance made to a staff member.
model SalaryPayment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("SalaryPaymentEmployee", fields: [userId], references: [id])

  type   SalaryPaymentType
  amount Int               // pesewas, always positive
  paidAt DateTime          @default(now())
  note   String?

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("SalaryPaymentCreated", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@map("salary_payments")
}

/// A business expense (rent, electricity, transport, supplies, etc.).
model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  category String  // free-text: Rent, Electricity, Transport, …
  amount   Int     // pesewas
  paidAt   DateTime @default(now())
  note     String?

  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([organizationId, paidAt])
  @@map("expenses")
}
