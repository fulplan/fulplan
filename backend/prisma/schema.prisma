// GhPOS — multi-tenant retail POS
//
// Conventions (see Data-Model.md / Architecture.md in the project vault):
//  * Every tenant-scoped table carries organizationId and is indexed on it.
//    Isolation is enforced twice: app-level tRPC middleware AND Postgres RLS.
//  * All money is stored as Int in MINOR UNITS (pesewas). Never Float/Decimal.
//  * Stock will be event-sourced: stock_movements is the source of truth,
//    stock_levels a rebuildable cache. (Added with the inventory feature.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  LOCKED
  CANCELLED
}

/// A tenant. One shop business = one Organization.
model Organization {
  id   String @id @default(cuid())
  name String

  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?

  // Growth loop: every org gets a code; referredByCode records who sent them.
  referralCode   String  @unique
  referredByCode String?

  // Set when the org self-service deletes; retained through a grace period.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches       Branch[]
  users          User[]
  devices        Device[]
  categories     Category[]
  products       Product[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@index([subscriptionStatus])
  @@map("organizations")
}

/// A physical shop location. An Organization may have many.
model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  address String?

  // Printed at the top of receipts for this branch.
  receiptHeader String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  devices        Device[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@index([organizationId])
  @@map("branches")
}

/// Staff. Owners/managers sign in with email + password; cashiers with a PIN.
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  role  Role   @default(CASHIER)

  // Owner/manager identity + account recovery anchor.
  email        String?
  passwordHash String?

  // Cashier fast login. Device-bound and rate-limited at the API layer.
  pinHash String?

  phone String?

  // Cashiers are assigned to a branch; owners see all branches by default.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices        Device[]
  stockMovements StockMovement[]

  // Email is unique per tenant, not globally — the same person could own
  // two separate shop businesses on the platform.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@map("users")
}

/// Product category — organises the product grid and reports.
model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("categories")
}

enum MovementType {
  PURCHASE   // stock in — receiving from supplier
  SALE       // stock out — from checkout
  ADJUSTMENT // manual correction / stock take
  RETURN     // stock back in — customer return
}

/// A sellable item.
///
/// Barcodes are TENANT-scoped — two shops legitimately use the same
/// manufacturer barcode for different local stock, so no global uniqueness.
///
/// Unit conversion: a "carton of 24 pieces" means purchaseUnit="carton",
/// saleUnit="piece", unitsPerPurchase=24.  Stock is always tracked in sale
/// units.
model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name    String
  barcode String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Unit conversion (purchase → sale).  Defaults to 1:1.
  purchaseUnit     String @default("unit")
  saleUnit         String @default("unit")
  unitsPerPurchase Int    @default(1)

  // All prices in PESEWAS (minor units).  Never Float.
  costPrice    Int // what we paid per sale unit
  sellingPrice Int // what we charge per sale unit

  lowStockThreshold Int @default(5)
  imageUrl          String?
  active            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]

  @@index([organizationId])
  @@index([organizationId, barcode])
  @@map("products")
}

/// Per-branch stock count cache.  Rebuilt from stock_movements if corrupted.
model StockLevel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  quantity Int @default(0) // in sale units

  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
  @@index([organizationId])
  @@map("stock_levels")
}

/// Append-only stock ledger.  Never update or delete rows — add corrections.
/// quantity is SIGNED: positive = stock in, negative = stock out (sale units).
model StockMovement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  type     MovementType
  quantity Int // signed, in sale units
  note     String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([productId, branchId])
  @@map("stock_movements")
}

/// A registered till/tablet/PC. Owners can revoke one remotely when a
/// device is lost or stolen, which invalidates its sessions.
model Device {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  label     String
  tokenHash String  @unique

  lastSeenAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("devices")
}
