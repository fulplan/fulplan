# Copy to .env for local dev. Never commit .env — secrets live in Railway env vars.

# ── Local dev ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml (port 5433 avoids clash with local PostgreSQL).
DATABASE_URL="postgresql://ghpos:ghpos_dev_password@localhost:5433/ghpos_dev?schema=public"

NODE_ENV="development"
PORT="3000"

# Frontend origin allowed to call this API
CORS_ORIGIN="http://localhost:5173"

# Auth — generate: openssl rand -hex 64
JWT_SECRET="dev-only-insecure-secret-change-me"

# ── Production (set in Railway dashboard, NOT here) ───────────────────────────
# DATABASE_URL   → auto-set by Railway PostgreSQL plugin
# REDIS_URL      → auto-set by Railway Redis plugin
# JWT_SECRET     → openssl rand -hex 64
# RESEND_API_KEY → from resend.com (free: 3k emails/mo)
# PAYSTACK_SECRET_KEY → from paystack.com → Settings → API Keys
# CORS_ORIGIN    → https://app.uptilll.com  (or Cloudflare Pages temp URL)
