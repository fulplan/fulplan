# Copy to .env and fill in. Never commit .env — secrets live in Railway/Vercel env vars.

# Local dev database (matches docker-compose.yml).
# Port 5433, not 5432 — avoids clashing with a locally installed PostgreSQL.
DATABASE_URL="postgresql://ghpos:ghpos_dev_password@localhost:5433/ghpos_dev?schema=public"

NODE_ENV="development"
PORT="3000"

# Frontend origin allowed to call this API
CORS_ORIGIN="http://localhost:5173"

# Auth — generate a long random string for real environments
JWT_SECRET="dev-only-insecure-secret-change-me"
